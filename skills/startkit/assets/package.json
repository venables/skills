{
  "name": "PROJECT_NAME",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm lint && pnpm format:check && pnpm test",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "PNPM_VERSION",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=NODE_MAJOR",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@PNPM_VERSION"
}
